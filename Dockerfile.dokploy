# Dokploy icin multi-stage imaj.
# Dokploy repo'yu klonlayip dogrudan bu Dockerfile'i build eder; sunucuda
# onceden mvn ile war uretmeye gerek yoktur, derleme adimi imaj icinde yapilir.

# ---------- 1) Derleme ----------
FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY . .
# .m2 cache'lenir
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -ntp clean package -DskipTests

# ---------- 2) Calistirma ----------
FROM eclipse-temurin:17-jre
ENV TZ=Europe/Istanbul
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN mkdir -p /app/pdf
COPY --from=build /build/target/wms.war /app/wms.war
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -Djava.security.egd=file:/dev/./urandom -Djdk.tls.client.protocols=TLSv1.2 -jar /app/wms.war"]
