# Bu dosyayı `.env` olarak kopyalayıp gerektiği kadarını değiştir.
# Hiçbirini doldurmasan da docker-compose.yml içindeki varsayılanlarla çalışır.

# dev  -> DEBUG log + liquibase örnek verisi + CORS açık
# prod -> production'a benzer, daha sessiz
SPRING_PROFILE=prod,api-docs

APP_PORT=8080
JAVA_OPTS=-Xms256m -Xmx1024m

POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=wms
POSTGRES_PORT=5432

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Gerçek servislere bağlanmak istersen doldur, boşsa sahte değerler kullanılır
WEBSOCKET_URI=
WEBSOCKET_PORT=8090
METABASE_SECRET_URL=
METABASE_SECRET_KEY=
METABASE_DASHBOARD_CODE=
SENTRY_DSN=

# MinIO (S3)
MINIO_ACCESS_KEY=wmsadmin
MINIO_SECRET_KEY=wmsadmin123
MINIO_BUCKET=wms
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Uzak bir S3'e bağlanmak istersen (şema dahil): https://s3-****.ns53.co
MINIO_URL=
