<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity MikroStokBarkodRel
    -->
    <changeSet id="20220819000011-1" author="jhipster">
        <createTable tableName="mikro_stok_barkod_rel">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stok_kodu" type="varchar">
                <constraints nullable="true" />
            </column>
            <column name="stok_adi" type="varchar">
                <constraints nullable="true" />
            </column>
            <column name="barkod" type="varchar">
                <constraints nullable="true" />
            </column>
            <column name="ana_grup" type="varchar">
                <constraints nullable="true" />
            </column>
            <column name="alt_grup" type="varchar">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>
    <changeSet id="20220819000011-2" author="halil">
       <renameTable oldTableName="mikro_stok_barkod_rel" newTableName="erp_stock_info"/>
    </changeSet>
    <changeSet id="20220819000011-3" author="halil">
        <renameColumn tableName="erp_stock_info" oldColumnName="alt_grup" newColumnName="kategori_adi"/>
        <addColumn tableName="erp_stock_info">
            <column name="stok_birimi" type="varchar(25)"></column>
            <column name="miktar" type="double"></column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
