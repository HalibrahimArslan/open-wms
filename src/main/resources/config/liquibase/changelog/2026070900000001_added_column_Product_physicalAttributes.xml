<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added physical_attributes column to Product.
        getOrderDetailById (Mikro) response'undan gelen fiziksel ölçüler
        (agirlik, genislik, derinlik, yukseklik, dara) tekil barkod oluşturulurken
        ürün ilk kez kaydedildiğinde jsonb olarak saklanır.
    -->

    <changeSet id="20260709000001-1" author="halil">
        <addColumn tableName="product">
            <column name="physical_attributes" type="jsonb"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>