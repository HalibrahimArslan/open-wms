            </column>
            <column name="barkod" type="varchar(50)">
                <constraints nullable="true" />
            </column>
            <column name="order_amount" type="double">
                <constraints nullable="true" />
            </column>
            <column name="process_amount" type="double">
                <constraints nullable="true" />
            </column>
            <column name="erp_order_info" type="varchar(100)">
