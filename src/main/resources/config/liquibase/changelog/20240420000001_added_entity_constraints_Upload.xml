<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added constraints to Upload.
    -->

    <changeSet id="20240420000001-1" author="jhipster">
        <addColumn tableName="upload">
            <column type="bigint" name="feedback_id" ></column>
        </addColumn>

    </changeSet>
    <changeSet id="20240420000001-2" author="jhipster">
        <addForeignKeyConstraint baseTableName="upload" baseColumnNames="feedback_id"
                                 constraintName="fk_upload_feedback_id"
                                 referencedTableName="feedback"
                                 referencedColumnNames="id" />

    </changeSet>



</databaseChangeLog>

