<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity ProcessTree.
    -->
    <changeSet id="20230823000001-1" author="halil">
        <createTable tableName="customer_address">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
          <column name="address_id" type="bigint">
              <constraints nullable="false" />
          </column>
            <column name="cari_code" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="sevk_address" type="varchar">
                <constraints nullable="true"/>
            </column>
            <column name="sevk_tel" type="varchar">
                <constraints nullable="true" />
            </column>
            <column name="sevk_muhatap" type="varchar">
                <constraints nullable="true" />
            </column>
            <column name="sevk_acik_address" type="varchar">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>


</databaseChangeLog>
