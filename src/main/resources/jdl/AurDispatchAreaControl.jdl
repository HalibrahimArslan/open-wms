
entity AurDispatchAreaControl {
	status Boolean
}

// defining multiple oneToOne relationships
relationship OneToOne {
	AurDispatchAreaControl{aurOrderDetail} to AurTmpDetail
}

// Set pagination options
paginate AurDispatchAreaControl with pagination

// Use Data Transfer Objects (DTO)
dto * with mapstruct

// Set service options to all except few
service all with serviceImpl except AurDispatchAreaControl

// Set an angular suffix
// angularSuffix * with mySuffix
