# Lokalde tek komutla ayağa kaldırmak için multi-stage imaj.
# Derleme adımı CI (.gitlab-ci.yml) ile aynı imajı ve aynı maven komutunu kullanır,
# böylece makinede JDK 21 kurulu olmasına gerek kalmaz.

# ---------- 1) Derleme ----------
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY . .
# .m2 cache'lenir
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -ntp clean package -DskipTests

# ---------- 2) Çalıştırma ----------
FROM eclipse-temurin:21-jre
ENV TZ=Europe/Istanbul
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN mkdir -p /app/pdf
COPY --from=build /build/target/wms.war /app/wms.war
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -Djava.security.egd=file:/dev/./urandom -Djdk.tls.client.protocols=TLSv1.2 -jar /app/wms.war"]
